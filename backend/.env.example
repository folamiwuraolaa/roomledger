# Local development
DATABASE_URL=sqlite:///roommate_ledger.db
FLASK_SECRET_KEY=replace-with-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:8080
COOKIE_SECURE=false

# Production (Render + Supabase Session Pooler)
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# FLASK_SECRET_KEY=replace-with-a-long-random-production-secret
# FRONTEND_ORIGIN=https://roomledgers.vercel.app
# COOKIE_SECURE=true

# Optional SMTP settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Roommate Ledger <noreply@example.com>
