# Local development
DATABASE_URL=sqlite:///roommate_ledger.db
FLASK_SECRET_KEY=replace-with-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:8080
COOKIE_SECURE=false

# Production with Supabase PostgreSQL
# Copy the connection string from Supabase Dashboard -> Connect.
# For Vercel/serverless, prefer the Supabase Transaction Pooler connection.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
# FLASK_SECRET_KEY=use-a-long-random-production-secret
# FRONTEND_ORIGIN=https://your-frontend.vercel.app
# COOKIE_SECURE=true

# Optional SMTP settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Roommate Ledger <noreply@example.com>
